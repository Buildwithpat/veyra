NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/veyra
# Windows + Node.js >=24.13.0: if you see "querySrv ECONNREFUSED" on startup
# even though Compass connects fine with this same URI, that's a known Node
# DNS regression (nodejs/node#61435), not a config problem — server/src/config/db.ts
# already detects and works around it automatically, no action needed.

JWT_SECRET=replace-with-a-random-64-character-secret
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Marketplace Assistant — optional. Leave AI_PROVIDER unset to run the
# assistant on its built-in deterministic template responses (grounded in
# real marketplace data, no external API calls, works out of the box).
# Set AI_PROVIDER to one of: openai | groq | huggingface | gemini, and the
# matching key below, to upgrade to real LLM-generated answers. AI_MODEL is
# optional — each provider has a sensible default.
AI_PROVIDER=
AI_MODEL=
OPENAI_API_KEY=
GROQ_API_KEY=
HUGGINGFACE_API_KEY=
GEMINI_API_KEY=
